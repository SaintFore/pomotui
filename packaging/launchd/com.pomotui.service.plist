<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pomotui.service</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/pomotui-service</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <dict>
        <key>OtherJobEnabled</key>
        <dict>
            <key>com.pomotui.socket</key>
            <true/>
        </dict>
    </dict>
    <key>Sockets</key>
    <dict>
        <key>Listeners</key>
        <dict>
            <key>SockPathName</key>
            <string>/tmp/pomotui-runtime/pomotui.sock</string>
        </dict>
    </dict>
    <key>StandardErrorPath</key>
    <string>/tmp/pomotui-service.err</string>
</dict>
</plist>
