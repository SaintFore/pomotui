post_install() {
    # Try to enable as the installing user (works with paru + lingering)
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        sudo -u "$SUDO_USER" systemctl --user daemon-reload 2>/dev/null || true
        sudo -u "$SUDO_USER" systemctl --user enable --now pomotui.socket 2>/dev/null && return
    fi
    echo ""
    echo "==> To start Pomotui, run:"
    echo "    systemctl --user daemon-reload && systemctl --user enable --now pomotui.socket"
    echo ""
}

post_upgrade() {
    # pacman runs as root, often without the installing user's session variables.
    # Upgrade every logged-in user's running service, including lingering users.
    pomotui_users=$(loginctl list-users --no-legend --no-pager) || {
        echo "WARNING: Pomotui was upgraded, but user services could not be discovered." >&2
        echo "Run in your user session: systemctl --user daemon-reload && systemctl --user restart pomotui.service" >&2
        return 0
    }
    while read -r pomotui_uid pomotui_user pomotui_rest; do
        case "$pomotui_uid" in ''|*[!0-9]*|0) continue ;; esac
        if runuser -u "$pomotui_user" -- env \
            XDG_RUNTIME_DIR="/run/user/$pomotui_uid" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$pomotui_uid/bus" \
            systemctl --user daemon-reload \
            && runuser -u "$pomotui_user" -- env \
                XDG_RUNTIME_DIR="/run/user/$pomotui_uid" \
                DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$pomotui_uid/bus" \
                systemctl --user try-restart pomotui.service; then
            continue
        fi
        echo "WARNING: Pomotui was upgraded, but the Timer Service for $pomotui_user could not be restarted." >&2
        echo "Run as $pomotui_user: systemctl --user daemon-reload && systemctl --user restart pomotui.service" >&2
    done <<EOF
$pomotui_users
EOF
    return 0
}

pre_remove() {
    systemctl --user disable --now pomotui.socket 2>/dev/null || true
    systemctl --user stop pomotui.service 2>/dev/null || true
}

post_remove() {
    systemctl --user daemon-reload 2>/dev/null || true
}
